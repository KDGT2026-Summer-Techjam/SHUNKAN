# 開発環境では未設定でも起動できます。公開環境では必ず設定してください。
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# カスタムドメインを使う場合だけ、https://example.com の形式で追加します。
DJANGO_CSRF_TRUSTED_ORIGINS=

# Render では DATABASE_URL が優先されます。ローカルでは下記の個別設定を使います。
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
